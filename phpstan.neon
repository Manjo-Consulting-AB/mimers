includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    parseModelCastsMethod: true

    # En process, inte en per kärna. VPS:en har 2 GB RAM och varje worker tar
    # ~450 MiB; med parallella agenter i egna worktrees räckte inte minnet och
    # earlyoom dödade agentsessionerna (2026-11-15).
    parallel:
        maxNumberOfProcess: 1

    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests

    # Nivån är medvetet 5 och inte högre. Se ADR-0022 Testramverk och statisk
    # analys — den fångar riktiga fel utan att kräva docblock-ceremoni i all
    # modellkod, och är avsedd att höjas när konventionerna från issue 2 satt sig.
