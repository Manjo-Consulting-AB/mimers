APP_NAME=Mimers
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 10.6 i alla miljoer. Testsviten kor SQLite in-memory via phpunit.xml
# och bryr sig inte om varden har.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mimers
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uppladdningstak i byte, se config/files.php och [[Pipeline]] § Uppladdningsgränser.
FILES_MAX_UPLOAD_BYTES=67108864
# Intern omdirigering av nedladdningar (X-LiteSpeed-Location): false lokalt och
# i testsviten, true i staging/produktion via shared/.env — se issue 19a och
# [[ADR-0019 Filleverans]].
FILES_INTERNAL_REDIRECT=false
QUEUE_CONNECTION=database
# Köarbetarens retry-fönster, se ADR-0031: max-time + timeout (50 + 300 s)
# måste rymmas innan ett reserverat jobb blir tillgängligt igen.
DB_QUEUE_RETRY_AFTER=600

# Fritextsök, issue 15b — databasdrivrutinen söker direkt mot tabellen och
# håller inget eget index, se [[ADR-0012 Sök]].
SCOUT_DRIVER=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Mailgun: sätt MAIL_MAILER=mailgun och nycklarna nedan i staging/
# produktions shared/.env — en utvecklare som kopierar exemplet ska inte
# råka skicka riktiga mejl. Se issue 170 för kontot och DNS.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net
# Mailguns webhook (issue 38b): anropet verifieras med HMAC-SHA256 över
# timestamp+token mot den här nyckeln. Är den tom avvisar rutten allt,
# se config/notiser.php.
MAILGUN_WEBHOOK_SIGNING_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@mimers.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Dead man's switch (issue 43): delad hemlighet för GET /drift/heartbeat, som
# vakten på utvecklings-VPS:en läser. Sätts i produktionens shared/.env; utan
# den satt avvisar ytan allt, se config/drift.php.
DRIFT_TOKEN=

VITE_APP_NAME="${APP_NAME}"
