# Neka direkt åtkomst till /_protected/, men tillåt LiteSpeeds interna
# omdirigering. %{ORG_REQ_URI} håller URI:n från det ursprungliga anropet och
# ändras inte när LiteSpeed hämtar filen — /files/{ulid} passerar därför, ett
# direkt anrop mot /_protected/… nekas. Se [[ADR-0019 Filleverans]].
#
# Mönstret är "^", inte "^_protected/" — i en .htaccess inuti katalogen har
# katalogprefixet redan avlägsnats, så "^_protected/" matchar aldrig och
# regeln blir en öppen katalog som ser skyddad ut.
RewriteEngine On
RewriteCond %{ORG_REQ_URI} ^/_protected/
RewriteRule ^ - [F,L]

# Bälte utöver hängslet: skulle regeln någon gång sluta gälla ska en
# katalogförfrågan ändå inte räkna upp innehållet.
Options -Indexes
